{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marketing": {
      "root": "LokiAI-Website-UI/machine-room-live-main"
    },
    "workspace": {
      "root": "LokiAI-Desktop/stellar-dashboard-builder-main"
    }
  },
  "rewrites": [
    {
      "source": "/workspace/:path*",
      "destination": {
        "service": "workspace"
      }
    },
    {
      "source": "/workspace",
      "destination": {
        "service": "workspace"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
