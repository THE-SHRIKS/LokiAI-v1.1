{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marketing": {
      "root": "LokiAI-Website-UI/machine-room-live-main",
      "framework": "tanstack-start"
    },
    "workspace": {
      "root": "LokiAI-Desktop/stellar-dashboard-builder-main",
      "framework": "tanstack-start"
    }
  },
  "redirects": [
    {
      "source": "/login",
      "destination": "/workspace/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/workspace/login?mode=signup",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "/workspace/forgot-password",
      "permanent": false
    },
    {
      "source": "/reset-password",
      "destination": "/workspace/reset-password",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/workspace",
      "permanent": false
    },
    {
      "source": "/mobile-ui",
      "destination": "/android-app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/lokiai-android.apk",
      "destination": "https://lokiai.onrender.com/apk/download"
    },
    {
      "source": "/workspace/(.*)",
      "destination": {
        "service": "workspace"
      }
    },
    {
      "source": "/workspace",
      "destination": {
        "service": "workspace"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
