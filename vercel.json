{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marketing": {
      "root": "LokiAI-Website-UI/machine-room-live-main",
      "framework": "tanstack-start"
    },
    "workspace": {
      "root": "LokiAI-Desktop/stellar-dashboard-builder-main",
      "framework": "tanstack-start"
    }
  },
  "rewrites": [
    {
      "source": "/workspace/:path*",
      "destination": {
        "service": "workspace",
        "path": "/:path*"
      }
    },
    {
      "source": "/workspace",
      "destination": {
        "service": "workspace",
        "path": "/"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
