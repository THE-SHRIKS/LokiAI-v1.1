{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marketing": {
      "root": "LokiAI-Website-UI/machine-room-live-main",
      "framework": "tanstack-start"
    },
    "workspace": {
      "root": "LokiAI-Desktop/stellar-dashboard-builder-main",
      "framework": "tanstack-start",
      "routes": [
        {
          "src": "/workspace/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        },
        {
          "src": "/workspace",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/workspace/:path*",
      "destination": {
        "service": "workspace"
      }
    },
    {
      "source": "/workspace",
      "destination": {
        "service": "workspace"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
