# PostgreSQL connection string (Neon, Railway, or any managed Postgres).
# Neon requires ?sslmode=require in the URL itself — asyncpg parses that
# directly, no separate ssl= connect parameter needed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWTs — generate a long random string, keep it secret
JWT_SECRET_KEY=

# NVIDIA NIM API key — https://build.nvidia.com
NVIDIA_API_KEY=

# SMTP — used to send OTP verification and password-reset emails when
# EMAIL_RELAY_URL is NOT set (local dev). In production behind a host that
# blocks outbound SMTP (Render's free tier does), leave these set as
# fallback but rely on the relay below instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LokiAI

# Email relay — routes outbound email through the dashboard's Vercel
# serverless function (api/send-email.ts) instead of connecting to SMTP_HOST
# directly. Required in production on hosts that block outbound SMTP.
# EMAIL_RELAY_SECRET must match the same value set on the Vercel project.
EMAIL_RELAY_URL=https://your-dashboard.vercel.app/api/send-email
EMAIL_RELAY_SECRET=

# Comma-separated list of origins allowed to call the API with credentials
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Base URL of the dashboard — used to build links in emails (e.g. password reset)
DASHBOARD_URL=http://localhost:8080

# Comma-separated operator emails allowed to reach the cross-tenant routes
# (/admin/stats, /admin/feedback, /monitor/status, /monitor/log). These return
# every user's email and activity, so they are NOT open to ordinary accounts.
# Left empty, nobody is an operator and those routes are closed to everyone —
# the safe default. Matching is case-insensitive on the account's email.
ADMIN_EMAILS=

# Public HTTPS URL of THIS backend — embedded in pairing QR codes and
# WebSocket URLs so the phone knows where to call home. Required in
# production (Render/any host behind a proxy); without it the backend falls
# back to LAN-IP detection, which is wrong once it's not on your LAN.
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Optional: when set, GET /apk redirects here instead of serving a local
# build/ file (Render's filesystem is ephemeral and never has the ~140MB
# APK). Host the APK as a GitHub Release asset and point this at it.
APK_DOWNLOAD_URL=
APK_SIZE_MB=
