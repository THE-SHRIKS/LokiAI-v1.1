# PostgreSQL connection string (Neon, Railway, or any managed Postgres).
# Neon requires ?sslmode=require in the URL itself — asyncpg parses that
# directly, no separate ssl= connect parameter needed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWTs — generate a long random string, keep it secret
JWT_SECRET_KEY=

# NVIDIA NIM API key — https://build.nvidia.com
NVIDIA_API_KEY=

# SMTP — used to send OTP verification and password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LokiAI

# Comma-separated list of origins allowed to call the API with credentials
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Base URL of the dashboard — used to build links in emails (e.g. password reset)
DASHBOARD_URL=http://localhost:8080

# Public HTTPS URL of THIS backend — embedded in pairing QR codes and
# WebSocket URLs so the phone knows where to call home. Required in
# production (Render/any host behind a proxy); without it the backend falls
# back to LAN-IP detection, which is wrong once it's not on your LAN.
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Optional: when set, GET /apk redirects here instead of serving a local
# build/ file (Render's filesystem is ephemeral and never has the ~140MB
# APK). Host the APK as a GitHub Release asset and point this at it.
APK_DOWNLOAD_URL=
APK_SIZE_MB=
