<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Storage: every model, config and registry file this app writes goes to
      getApplicationDocumentsDirectory() - app-private internal storage, which
      needs no permission at all. The only external read is the legacy v2
      /sdcard/edgemind/config.json fallback, so READ is scoped to the API
      levels where it was actually required.

      MANAGE_EXTERNAL_STORAGE (All Files Access) was declared here but never
      requested anywhere in the code, and nothing needs it. It is a
      high-risk permission that triggers Play Store policy review and shows
      users an alarming "access all files" prompt for no functionality.
      Removed. WRITE_EXTERNAL_STORAGE is likewise unused and is capped at the
      last API level where it had any effect.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!--
      allowBackup / dataExtractionRules: the app holds a device-scoped bearer
      credential for its WebSocket. Android's default allowBackup="true" would
      make that credential eligible for cloud backup and restore onto a
      DIFFERENT handset, which would hand that phone this device's identity.
      Backup and device-to-device transfer are therefore disabled outright;
      re-pairing on a new device is the intended (and only) path.
    -->
    <application
        android:label="LokiAI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
