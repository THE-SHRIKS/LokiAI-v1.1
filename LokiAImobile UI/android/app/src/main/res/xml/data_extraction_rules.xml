<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer policy.

  The app stores a device-scoped WebSocket bearer credential in
  Keystore-backed EncryptedSharedPreferences. Keystore material is not
  transferable between devices anyway, but an extracted encrypted blob plus
  restored pairing data would still be a needless leak of device identity, and
  a restored install pointing at another phone's device_id causes confusing
  duplicate-connection behaviour server-side.

  Both cloud backup and device-to-device transfer are therefore excluded
  entirely. Re-pairing from the dashboard is the supported path onto a new
  device — the app prompts for it automatically when the backend rejects a
  credential (WebSocket close 4401).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
